    "openings": 8,
    "syllables_with_opening": 8
   },
   {
    "t0": 55.91,
    "text": "Że dziś na siłę robisz wielki gest",
    "syllables": 10,
    "openings": 10,
    "syllables_with_opening": 10
   },
   {
    "t0": 60.11,
    "text": "Puste zasięgi, puste zasięgi",
