  "worst_lines": [
   {
    "t0": 3.27,
    "text": "\"No i co tam na tym LinkedInie dzisiaj, kochani? Kolejny suk",
    "syllables": 23,
    "openings": 23,
    "syllables_with_opening": 23
   },
   {
    "t0": 14.16,
    "text": "Poranna kawa, wielki plan",
    "syllables": 8,
    "openings": 8,
    "syllables_with_opening": 8
   },
   {
    "t0": 17.53,
    "text": "Wkładam garnitur, choć mam luźny stan",
    "syllables": 10,
    "openings": 10,
    "syllables_with_opening": 10
   },
   {
    "t0": 20.56,
    "text": "Piszę o synergiach, choć boli mnie szczęka",
    "syllables": 12,
    "openings": 12,
    "syllables_with_opening": 12
   },
   {
    "t0": 22.99,
    "text": "„Z przyjemnością dzielę się” — i już mnie skręca",
    "syllables": 12,
    "openings": 12,
    "syllables_with_opening": 12
   },
   {
    "t0": 27.01,
    "text": "\"Tak, tak, wszyscy się strasznie cieszą!\"",
    "syllables": 9,
    "openings": 9,
    "syllables_with_opening": 9
   },
   {
    "t0": 33.23,
    "text": "W tle awans, w głowie stres",
    "syllables": 6,
    "openings": 6,
    "syllables_with_opening": 6
   },
   {
    "t0": 36.28,
    "text": "Wszyscy tu mają strategiczny gest",
